# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_USER=prescriptrace
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=prescriptrace
POSTGRES_PORT=5432
# Used by the backend; "db" is the docker-compose service name.
DATABASE_URL=postgresql+psycopg://prescriptrace:change-me-locally@db:5432/prescriptrace

# --- Backend ---
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Normalisation thresholds (see docs/PLAN.md §2); tuned on the evaluation set.
NORMALISE_AUTO_ACCEPT=0.90
NORMALISE_CONFIRM_MIN=0.60
# Per-IP rate limits (slowapi syntax).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_NORMALISE=60/minute
RATE_LIMIT_CHECK=30/minute
RATE_LIMIT_OCR=10/minute
RATE_LIMIT_OFFLINE_PACK=6/minute
# Build the offline pack (~10 s) in the background at startup instead of on first request.
OFFLINE_PACK_PREBUILD=true

# --- External data (optional) ---
# openFDA works without a key (1,000 requests/day/IP); a free key raises this to 120,000/day.
OPENFDA_API_KEY=

# --- OCR ---
# tesseract (default, local, private) | vision_llm (optional; sends images off-device)
OCR_ENGINE=tesseract

# --- Optional LLM rephrasing (off by default; only rephrases facts already retrieved) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8000
